        "func": "// Тема kharkiv/air/<id>/status, вміст online|offline\nconst station = msg.topic.split(\"/\")[2];\nconst online = msg.payload === \"online\" ? 1 : 0;\nmsg.params = [station, online];   // $1, $2 у запиті\nreturn msg;",
