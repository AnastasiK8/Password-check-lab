    {
        "id": "f_line",
        "type": "function",
        "z": "pr5tab",
        "name": "Параметри запиту",
        "func": "const p = msg.payload;\nmsg.params = [\n    msg.ts,                  // $1 — час виміру, мс від 1970 р.\n    msg.station,             // $2 — вузол\n    p.p, p.p_ema, p.dp,      // $3, $4, $5\n    p.q,                     // $6\n    p.alarm,                 // $7\n    Date.now() - msg.ts,     // $8 — затримка, формула (10)\n];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 120,
