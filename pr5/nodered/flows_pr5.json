    {
        "id": "f_val",
        "type": "function",
        "z": "pr5tab",
        "name": "Перевірка даних",
        "func": "const station = msg.topic.split(\"/\")[2];\nconst d = msg.payload;\nconst ok = (v, lo, hi) => typeof v === \"number\" && v >= lo && v <= hi;\nconst errors = [];\nif (!ok(d.p, 0, 10)) errors.push(\"p\");\nif (!ok(d.q, 0, 500)) errors.push(\"q\");\nif (!Number.isInteger(d.ts)) errors.push(\"ts\");\n\nif (errors.length > 0) {\n    const n = (context.get(\"rejected\") || 0) + 1;\n    context.set(\"rejected\", n);\n    node.status({ fill: \"red\", shape: \"dot\", text: `відхилено: ${n}` });\n    msg.payload = { station, errors, raw: d };\n    return [null, msg];\n}\nmsg.station = station;\nmsg.ts = d.ts;\nmsg.payload = { p: d.p, q: d.q };\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 120,
        "wires": [
            [
                "f_proc"
            ],
            [
                "dbg_bad"
            ]
        ]
    },
    {
        "id": "dbg_bad",
        "type": "debug",
        "z": "pr5tab",
        "name": "Відхилені",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "counter",
        "x": 580,
        "y": 200,
        "wires": []
    },
    {
        "id": "f_proc",
        "type": "function",
        "z": "pr5tab",
        "name": "Δp, згладжування, тривога",
        "func": "const ALPHA = 0.2;\nconst ON = -0.5;     // тривога вмикається при Δp ≤ -0,5 бар\nconst OFF = -0.2;    // вимикається при Δp ≥ -0,2 бар\n\nconst key = \"st_\" + msg.station;\nconst st = context.get(key) || { ema: null, alarm: 0 };\nconst x = msg.payload.p;\n\n// (В8): відхилення від EMA ДО цього виміру\nconst dp = st.ema === null ? 0 : x - st.ema;\n// (8): експоненційне згладжування\nst.ema = st.ema === null ? x : ALPHA * x + (1 - ALPHA) * st.ema;\n// (9): тривога з гістерезисом\nconst before = st.alarm;\nif (st.alarm === 0 && dp <= ON) st.alarm = 1;\nelse if (st.alarm === 1 && dp >= OFF) st.alarm = 0;\ncontext.set(key, st);\n\nmsg.payload.p_ema = Math.round(st.ema * 1000) / 1000;\nmsg.payload.dp = Math.round(dp * 1000) / 1000;\nmsg.payload.alarm = st.alarm;\n\nlet alarmMsg = null;                 // лише при зміні стану\nif (st.alarm !== before) {\n    alarmMsg = {\n        topic: `kharkiv/water/${msg.station}/alarm`,\n        payload: JSON.stringify({\n            ts: msg.ts,\n            alarm: st.alarm,\n            dp: msg.payload.dp,\n            p_ema: msg.payload.p_ema,\n        }),\n    };\n}\nreturn [msg, alarmMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 120,
        "wires": [
            [
                "f_line"
            ],
            [
                "out_alarm",
                "dbg_alarm"
            ]
        ]
    },
